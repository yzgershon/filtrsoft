{
  "name": "assyze",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tells you what a used tech listing is really worth and what's wrong with it, before you drive.",
  "scripts": {
    "seed": "bun run src/scripts/seed.ts",
    "stats": "bun run src/scripts/stats.ts",
    "ingest": "bun run src/scripts/ingest.ts",
    "verdict": "bun run src/scripts/verdict.ts",
    "score": "bun run src/scripts/score.ts",
    "comps:provisional": "bun run src/scripts/seed-provisional-comps.ts",
    "check": "bun run src/scripts/check.ts",
    "api": "bun run --hot src/api/index.ts",
    "build": "cd web && bun install && bun run build",
    "start": "bun run src/api/index.ts",
    "crawl": "bun run src/scripts/crawl.ts",
    "backup": "bun run src/scripts/backup.ts",
    "sweep": "bun run src/scripts/sweep.ts",
    "outcomes": "bun run src/scripts/outcomes.ts",
    "review": "bun run src/scripts/review.ts",
    "catalog:derive": "bun run src/scripts/derive-catalog.ts",
    "fb:login": "bun run src/scripts/fb-login.ts",
    "fb:crawl": "bun run src/scripts/fb-crawl.ts",
    "ebay:login": "bun run src/scripts/ebay-login.ts",
    "ebay:comps": "bun run src/scripts/ebay-comps.ts",
    "retail": "bun run src/scripts/retail.ts",
    "archive": "bun run src/scripts/archive.ts",
    "push": "bun run src/scripts/push.ts",
    "ou:crawl": "bun run src/scripts/marketplace-crawl.ts --source offerup",
    "mc:crawl": "bun run src/scripts/marketplace-crawl.ts --source mercari",
    "ebay:auth": "bun run src/scripts/ebay-auth.ts",
    "ebay:search": "bun run src/scripts/ebay-search.ts",
    "photos:prune": "bun run src/scripts/photos-prune.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "hono": "^4.13.3",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3",
    "stripe": "^22.5.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  }
}
