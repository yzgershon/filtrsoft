# LEADING SLASHES ARE LOAD-BEARING.
#
# A bare `photos` pattern took down the Railway deploy: Docker's builder treats
# it as root-only, but Railway's matched it against `src/photos` as well, so
# src/photos/index.ts was silently absent from the image and the container died
# with "Cannot find module '../photos/index.ts'". Anchor everything.

/node_modules
/web/node_modules
/web/dist
/.git

# Downloaded listing images (runtime output) — NOT src/photos, which is code.
/photos

/filtrsoft.db
/filtrsoft.db-wal
/filtrsoft.db-shm
/.env

# Test-set photos are large and unneeded in production. The audit JSON beside
# them is small and IS needed — it seeds the eval set.
/docs/testset/cl-*

# Local snapshots, worktrees, reports and environment files never enter images.
/backups
/.worktrees
/.codex
/.env.*
/*.db
/*.db-wal
/*.db-shm

# Ship the verified current archive, not its local undo copy.
/data/archive.json.gz.previous
